# Photoshop API credentials (Adobe Developer Console, Firefly Services)
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# Photoshop API reads and writes files through signed URLs, so it needs S3 style storage
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# "local" edits the PSD inside this app. "photoshop" uses the Photoshop API.
EDIT_ENGINE=local

# Set by Vercel when a Blob store is connected. Switches storage from local disk to private Blob.
BLOB_READ_WRITE_TOKEN=
